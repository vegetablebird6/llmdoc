{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmdoc.dev/schemas/output.schema.json",
  "$defs": {
    "kind": {
      "type": "string",
      "enum": [
        "architecture",
        "guide",
        "reference"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalItems",
        "returnedItems",
        "totalEstimatedTokens",
        "returnedEstimatedTokens",
        "nextCursor"
      ],
      "properties": {
        "totalItems": {
          "type": "integer",
          "minimum": 0
        },
        "returnedItems": {
          "type": "integer",
          "minimum": 0
        },
        "totalEstimatedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "returnedEstimatedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "docRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "description"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "message"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "growth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentDocumentCount",
        "currentTotalEstimatedTokens",
        "baselineDocumentCount",
        "baselineTotalEstimatedTokens",
        "documentDelta",
        "tokenDelta",
        "exceedsGate"
      ],
      "properties": {
        "currentDocumentCount": {
          "type": "integer",
          "minimum": 0
        },
        "currentTotalEstimatedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "baselineDocumentCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "baselineTotalEstimatedTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "documentDelta": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tokenDelta": {
          "type": [
            "integer",
            "null"
          ]
        },
        "exceedsGate": {
          "type": "boolean"
        }
      }
    },
    "validate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "errors",
        "warnings"
      ],
      "properties": {
        "schema": {
          "const": "llmdoc.validate/v1"
        },
        "ok": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeIssue"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeIssue"
          }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "repositoryId",
        "knowledgeRoot",
        "sourceRevision",
        "knowledgeRevision",
        "knowledgeBranch",
        "sourceBlockers",
        "historyAvailable",
        "lastGlobalReviewRevision",
        "index",
        "drafts",
        "documents",
        "reviewObligations",
        "issues"
      ],
      "properties": {
        "schema": {
          "const": "llmdoc.status/v1"
        },
        "repositoryId": {
          "type": "string"
        },
        "knowledgeRoot": {
          "type": "string"
        },
        "sourceRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "knowledgeRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "knowledgeBranch": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceBlockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeSourceBlocker"
          }
        },
        "historyAvailable": {
          "type": "boolean"
        },
        "lastGlobalReviewRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "index": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "clean",
            "stagedPaths"
          ],
          "properties": {
            "clean": {
              "type": "boolean"
            },
            "stagedPaths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "drafts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "documents": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "current",
            "needsReview",
            "unverified"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "current": {
              "type": "integer",
              "minimum": 0
            },
            "needsReview": {
              "type": "integer",
              "minimum": 0
            },
            "unverified": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "reviewObligations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "reasons"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "$ref": "#/$defs/knowledgeStatus"
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeIssue"
          }
        }
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "repositoryId",
        "sourceRevision",
        "knowledgeRevision",
        "knowledgeBranch",
        "sourceBlockers",
        "historyAvailable",
        "lastGlobalReviewRevision",
        "suggestedMode",
        "reasons",
        "impacted"
      ],
      "properties": {
        "schema": {
          "const": "llmdoc.delta/v1"
        },
        "repositoryId": {
          "type": "string"
        },
        "sourceRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "knowledgeRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "knowledgeBranch": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceBlockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeSourceBlocker"
          }
        },
        "historyAvailable": {
          "type": "boolean"
        },
        "lastGlobalReviewRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "suggestedMode": {
          "type": "string",
          "enum": [
            "light",
            "deep"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "impacted": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "action",
              "contentChanged",
              "scopeRemoved",
              "requiresChanged",
              "reasons"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "contentChanged": {
                "type": "boolean"
              },
              "scopeRemoved": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requiresChanged": {
                "type": "boolean"
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "pruneCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "topic",
        "status",
        "eligible",
        "reasons"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "topic": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "eligible": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "prune": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "repositoryId",
        "sourceRevision",
        "knowledgeRevision",
        "candidates",
        "removed",
        "repairedDocuments",
        "reviewId",
        "writeSet",
        "cleanupRequired"
      ],
      "properties": {
        "schema": {
          "const": "llmdoc.prune/v1"
        },
        "status": {
          "type": "string",
          "enum": [
            "reported",
            "prepared"
          ]
        },
        "repositoryId": {
          "type": "string"
        },
        "sourceRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "knowledgeRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pruneCandidate"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "repairedDocuments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reviewId": {
          "type": [
            "string",
            "null"
          ]
        },
        "writeSet": {
          "type": [
            "object",
            "null"
          ]
        },
        "cleanupRequired": {
          "type": "boolean"
        }
      }
    },
    "legacyIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "path",
        "message"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "const": "warning"
        },
        "code": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "migrateDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacyId",
        "targetId",
        "status",
        "kind",
        "description",
        "sourcePaths",
        "codeRefs",
        "linksRewritten",
        "requires",
        "related",
        "issues"
      ],
      "properties": {
        "legacyId": {
          "type": "string"
        },
        "targetId": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "converted",
            "skipped",
            "collision"
          ]
        },
        "kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourcePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "codeRefs": {
          "type": "integer",
          "minimum": 0
        },
        "linksRewritten": {
          "type": "integer",
          "minimum": 0
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/legacyIssue"
          }
        }
      }
    },
    "migrate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "dryRun",
        "sourceRoot",
        "legacyRoot",
        "targetRoot",
        "repositoryId",
        "knowledgeCommit",
        "bound",
        "documents",
        "conflicts",
        "issues",
        "legacyMeta",
        "config"
      ],
      "properties": {
        "schema": {
          "const": "llmdoc.migrate/v1"
        },
        "status": {
          "type": "string",
          "enum": [
            "dry_run",
            "migrated",
            "already_migrated"
          ]
        },
        "dryRun": {
          "type": "boolean"
        },
        "sourceRoot": {
          "type": "string"
        },
        "legacyRoot": {
          "type": "string"
        },
        "targetRoot": {
          "type": "string"
        },
        "repositoryId": {
          "type": [
            "string",
            "null"
          ]
        },
        "knowledgeCommit": {
          "type": [
            "string",
            "null"
          ]
        },
        "bound": {
          "type": "boolean"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/migrateDocument"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/legacyIssue"
          }
        },
        "legacyMeta": {
          "type": [
            "object",
            "null"
          ]
        },
        "config": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "reviewId",
        "repositoryId",
        "sourceRevision",
        "knowledgeBaseRevision",
        "knowledgeRevision",
        "branch",
        "metaOnly",
        "changedDocuments",
        "refreshedDocuments",
        "deletedDocuments",
        "removedCandidates",
        "lastGlobalReviewRevision",
        "cleanupRequired",
        "sync"
      ],
      "properties": {
        "schema": {
          "const": "llmdoc.commit/v1"
        },
        "status": {
          "type": "string",
          "enum": [
            "success",
            "no_change"
          ]
        },
        "reviewId": {
          "type": "string"
        },
        "repositoryId": {
          "type": "string"
        },
        "sourceRevision": {
          "type": "string"
        },
        "knowledgeBaseRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "knowledgeRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "metaOnly": {
          "type": "boolean"
        },
        "changedDocuments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "refreshedDocuments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deletedDocuments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removedCandidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lastGlobalReviewRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "cleanupRequired": {
          "type": "boolean"
        },
        "sync": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index",
            "files",
            "errors"
          ],
          "properties": {
            "index": {
              "type": "string",
              "enum": [
                "synced",
                "failed",
                "skipped"
              ]
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "synced"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "synced": {
                    "type": "boolean"
                  }
                }
              }
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "reviewId",
        "repositoryId",
        "sourceRevision",
        "knowledgeBaseRevision",
        "knowledgeRoot",
        "global",
        "confirmed",
        "writeSet",
        "documents"
      ],
      "properties": {
        "schema": {
          "const": "llmdoc.review/v1"
        },
        "status": {
          "type": "string",
          "enum": [
            "generated",
            "confirmed"
          ]
        },
        "reviewId": {
          "type": "string"
        },
        "repositoryId": {
          "type": "string"
        },
        "sourceRevision": {
          "type": "string"
        },
        "knowledgeBaseRevision": {
          "type": "string"
        },
        "knowledgeRoot": {
          "type": "string"
        },
        "global": {
          "type": "boolean"
        },
        "confirmed": {
          "type": "boolean"
        },
        "writeSet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "documents",
            "refresh",
            "deletions",
            "candidates",
            "meta",
            "generated"
          ],
          "properties": {
            "documents": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "refresh": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deletions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "meta": {
              "type": "boolean"
            },
            "generated": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "action",
              "proposedConclusion",
              "conclusion",
              "oldDigest",
              "candidateDigest",
              "oldScope",
              "newScope",
              "removedScope",
              "oldSourceRevision",
              "oldValidatedRequires",
              "candidateRequires",
              "reasons"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "proposedConclusion": {
                "type": "string"
              },
              "conclusion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "oldDigest": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "candidateDigest": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "oldScope": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "newScope": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "removedScope": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "oldSourceRevision": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "oldValidatedRequires": {
                "type": "object"
              },
              "candidateRequires": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "digest"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "digest": {
                      "type": "string"
                    }
                  }
                }
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "syncResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "files",
        "errors"
      ],
      "properties": {
        "index": {
          "type": "string",
          "enum": [
            "synced",
            "failed",
            "skipped"
          ]
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "synced"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "synced": {
                "type": "boolean"
              }
            }
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "candidateId",
        "repositoryId",
        "sourceRevision",
        "knowledgeBaseRevision",
        "knowledgeRevision",
        "branch",
        "cleanupRequired",
        "sync"
      ],
      "properties": {
        "schema": {
          "const": "llmdoc.capture/v1"
        },
        "status": {
          "type": "string",
          "const": "captured"
        },
        "candidateId": {
          "type": "string"
        },
        "repositoryId": {
          "type": "string"
        },
        "sourceRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "knowledgeBaseRevision": {
          "type": "string"
        },
        "knowledgeRevision": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "cleanupRequired": {
          "type": "boolean"
        },
        "sync": {
          "$ref": "#/$defs/syncResult"
        }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "repositoryId",
        "sourceRevision",
