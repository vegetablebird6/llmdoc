{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmdoc.dev/schemas/output.schema.json",
  "$defs": {
    "kind": {
      "type": "string",
      "enum": [
        "architecture",
        "guide",
        "reference"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalItems",
        "returnedItems",
        "totalEstimatedTokens",
        "returnedEstimatedTokens",
        "nextCursor"
      ],
      "properties": {
        "totalItems": {
          "type": "integer",
          "minimum": 0
        },
        "returnedItems": {
          "type": "integer",
          "minimum": 0
        },
        "totalEstimatedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "returnedEstimatedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "docRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "description"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "message"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "growth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentDocumentCount",
        "currentTotalEstimatedTokens",
        "baselineDocumentCount",
        "baselineTotalEstimatedTokens",
        "documentDelta",
        "tokenDelta",
        "exceedsGate"
      ],
      "properties": {
        "currentDocumentCount": {
          "type": "integer",
          "minimum": 0
        },
        "currentTotalEstimatedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "baselineDocumentCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "baselineTotalEstimatedTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "documentDelta": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tokenDelta": {
          "type": [
            "integer",
            "null"
          ]
        },
        "exceedsGate": {
          "type": "boolean"
        }
      }
    },
    "validate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "ok",
        "errors",
        "warnings"
      ],
      "properties": {
        "schema": {
          "const": "llmdoc.validate/v1"
        },
        "ok": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeIssue"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeIssue"
          }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "repositoryId",
        "knowledgeRoot",
        "sourceRevision",
        "knowledgeRevision",
        "knowledgeBranch",
        "sourceBlockers",
        "historyAvailable",
        "lastGlobalReviewRevision",
        "index",
        "drafts",
        "documents",
        "reviewObligations",
        "issues"
      ],
      "properties": {
        "schema": {
          "const": "llmdoc.status/v1"
        },
        "repositoryId": {
          "type": "string"
        },
        "knowledgeRoot": {
          "type": "string"
        },
        "sourceRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "knowledgeRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "knowledgeBranch": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceBlockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeSourceBlocker"
          }
        },
        "historyAvailable": {
          "type": "boolean"
        },
        "lastGlobalReviewRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "index": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "clean",
            "stagedPaths"
          ],
          "properties": {
            "clean": {
              "type": "boolean"
            },
            "stagedPaths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "drafts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "documents": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "current",
            "needsReview",
            "unverified"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "current": {
              "type": "integer",
              "minimum": 0
            },
            "needsReview": {
              "type": "integer",
              "minimum": 0
            },
            "unverified": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "reviewObligations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "status",
              "reasons"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "$ref": "#/$defs/knowledgeStatus"
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeIssue"
          }
        }
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "repositoryId",
        "sourceRevision",
        "knowledgeRevision",
        "knowledgeBranch",
        "sourceBlockers",
        "historyAvailable",
        "lastGlobalReviewRevision",
        "suggestedMode",
        "reasons",
        "impacted"
      ],
      "properties": {
        "schema": {
          "const": "llmdoc.delta/v1"
        },
        "repositoryId": {
          "type": "string"
        },
        "sourceRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "knowledgeRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "knowledgeBranch": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceBlockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeSourceBlocker"
          }
        },
        "historyAvailable": {
          "type": "boolean"
        },
        "lastGlobalReviewRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "suggestedMode": {
          "type": "string",
          "enum": [
            "light",
            "deep"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "impacted": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "action",
              "contentChanged",
              "scopeRemoved",
              "requiresChanged",
              "reasons"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "contentChanged": {
                "type": "boolean"
              },
              "scopeRemoved": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "requiresChanged": {
                "type": "boolean"
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "updateAll",
        "updated",
        "baselineRevision"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "success"
        },
        "updateAll": {
          "type": "boolean"
        },
        "updated": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "baselineRevision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "prune": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "writable",
        "growth",
        "startupPreloads",
        "duplicateCandidates",
        "mergeCandidates"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "dry_run"
        },
        "writable": {
          "type": "boolean",
          "const": false
        },
        "growth": {
          "$ref": "#/$defs/growth"
        },
        "startupPreloads": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "duplicateCandidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "paths",
              "score",
              "reasons"
            ],
            "properties": {
              "paths": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "score": {
                "type": "number"
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "mergeCandidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "topic",
              "paths",
              "totalEstimatedTokens",
              "reasons"
            ],
            "properties": {
              "topic": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "totalEstimatedTokens": {
                "type": "integer",
                "minimum": 0
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "upgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "legacyPaths",
        "targetStructure",
        "requiresRecorderSemanticMigration",
        "notes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "no_change",
            "dry_run"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "legacyPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "targetStructure": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiresRecorderSemanticMigration": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "new": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created",
        "next"
      ],
      "properties": {
        "created": {
          "type": "string",
          "minLength": 1
        },
        "next": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "adopt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adopted",
        "alreadyRegistered"
      ],
      "properties": {
        "adopted": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "alreadyRegistered": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "mv": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moved",
        "rewrittenConfig",
        "rewrittenDocuments"
      ],
      "properties": {
        "moved": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "string",
              "minLength": 1
            },
            "to": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "rewrittenDocuments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rewrittenConfig": {
          "type": "boolean"
        }
      }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "continue"
      ],
      "properties": {
        "continue": {
          "type": "boolean",
          "const": true
        },
        "systemMessage": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "initState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "documents",
        "baselineRevision",
        "next"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "success"
        },
        "documents": {
          "type": "integer",
          "minimum": 0
        },
        "baselineRevision": {
          "type": "string",
          "minLength": 1
        },
        "next": {
          "type": "string"
        }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "reviewId",
        "repositoryId",
        "sourceRevision",
        "knowledgeBaseRevision",
        "knowledgeRevision",
        "branch",
        "metaOnly",
        "changedDocuments",
        "refreshedDocuments",
        "deletedDocuments",
        "lastGlobalReviewRevision",
        "cleanupRequired",
        "sync"
      ],
      "properties": {
        "schema": {
          "const": "llmdoc.commit/v1"
        },
        "status": {
          "type": "string",
          "enum": [
            "success",
            "no_change"
          ]
        },
        "reviewId": {
          "type": "string"
        },
        "repositoryId": {
          "type": "string"
        },
        "sourceRevision": {
          "type": "string"
        },
        "knowledgeBaseRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "knowledgeRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "metaOnly": {
          "type": "boolean"
        },
        "changedDocuments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "refreshedDocuments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deletedDocuments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lastGlobalReviewRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "cleanupRequired": {
          "type": "boolean"
        },
        "sync": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index",
            "files",
            "errors"
          ],
          "properties": {
            "index": {
              "type": "string",
              "enum": [
                "synced",
                "failed",
                "skipped"
              ]
            },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "synced"
                ],
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "synced": {
                    "type": "boolean"
                  }
                }
              }
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "reviewId",
        "repositoryId",
        "sourceRevision",
        "knowledgeBaseRevision",
        "knowledgeRoot",
        "global",
        "confirmed",
        "writeSet",
        "documents"
      ],
      "properties": {
        "schema": {
          "const": "llmdoc.review/v1"
        },
        "status": {
          "type": "string",
          "enum": [
            "generated",
            "confirmed"
          ]
        },
        "reviewId": {
          "type": "string"
        },
        "repositoryId": {
          "type": "string"
        },
        "sourceRevision": {
          "type": "string"
        },
        "knowledgeBaseRevision": {
          "type": "string"
        },
        "knowledgeRoot": {
          "type": "string"
        },
        "global": {
          "type": "boolean"
        },
        "confirmed": {
          "type": "boolean"
        },
        "writeSet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "documents",
            "refresh",
            "deletions",
            "meta",
            "generated"
          ],
          "properties": {
            "documents": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "refresh": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "deletions": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "meta": {
              "type": "boolean"
            },
            "generated": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "documents": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "action",
              "proposedConclusion",
              "conclusion",
              "oldDigest",
              "candidateDigest",
              "oldScope",
              "newScope",
              "removedScope",
              "oldSourceRevision",
              "oldValidatedRequires",
              "candidateRequires",
              "reasons"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "proposedConclusion": {
                "type": "string"
              },
              "conclusion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "oldDigest": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "candidateDigest": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "oldScope": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "newScope": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "removedScope": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "oldSourceRevision": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "oldValidatedRequires": {
                "type": "object"
              },
              "candidateRequires": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "digest"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "digest": {
                      "type": "string"
                    }
                  }
                }
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "bind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "repositoryId",
        "sourcePath",
        "knowledgeRoot"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "bound",
            "already-bound"
          ]
        },
        "repositoryId": {
          "type": "string",
          "pattern": "^llmdoc-[0-9a-f]{32}$"
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "knowledgeRoot": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "init": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryId",
        "sourcePath",
        "knowledgeRoot",
        "knowledgeCommit"
      ],
      "properties": {
        "repositoryId": {
          "type": "string",
          "pattern": "^llmdoc-[0-9a-f]{32}$"
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "knowledgeRoot": {
          "type": "string",
          "minLength": 1
        },
        "knowledgeCommit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "knowledgeError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "paths",
            "remediation"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "remediation": {
              "type": "string"
            }
          }
        }
      }
    },
    "knowledgeKind": {
      "type": "string",
      "enum": [
        "architecture",
        "decision",
        "guide",
        "reference"
      ]
    },
    "knowledgeStatus": {
      "type": "string",
      "enum": [
        "unverified",
        "current",
        "needs_review"
      ]
    },
