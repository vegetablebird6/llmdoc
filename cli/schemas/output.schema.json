{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llmdoc.dev/schemas/output.schema.json",
  "$defs": {
    "kind": {
      "type": "string",
      "enum": [
        "architecture",
        "guide",
        "reference"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalItems",
        "returnedItems",
        "totalEstimatedTokens",
        "returnedEstimatedTokens",
        "nextCursor"
      ],
      "properties": {
        "totalItems": {
          "type": "integer",
          "minimum": 0
        },
        "returnedItems": {
          "type": "integer",
          "minimum": 0
        },
        "totalEstimatedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "returnedEstimatedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "docRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "description"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "kind": {
          "$ref": "#/$defs/kind"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "message"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "growth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentDocumentCount",
        "currentTotalEstimatedTokens",
        "baselineDocumentCount",
        "baselineTotalEstimatedTokens",
        "documentDelta",
        "tokenDelta",
        "exceedsGate"
      ],
      "properties": {
        "currentDocumentCount": {
          "type": "integer",
          "minimum": 0
        },
        "currentTotalEstimatedTokens": {
          "type": "integer",
          "minimum": 0
        },
        "baselineDocumentCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "baselineTotalEstimatedTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "documentDelta": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tokenDelta": {
          "type": [
            "integer",
            "null"
          ]
        },
        "exceedsGate": {
          "type": "boolean"
        }
      }
    },
    "validate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "errors",
        "warnings"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "head",
        "commitsBehindHead",
        "relevantCommitsBehindHead",
        "degradedReason",
        "documents",
        "unmapped",
        "growth"
      ],
      "properties": {
        "baseline": {
          "type": [
            "string",
            "null"
          ]
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        },
        "commitsBehindHead": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "relevantCommitsBehindHead": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "degradedReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "documents": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "impacted",
            "needsReview",
            "dirty"
          ],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "impacted": {
              "type": "integer",
              "minimum": 0
            },
            "needsReview": {
              "type": "integer",
              "minimum": 0
            },
            "dirty": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "unmapped": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "committed",
            "dirty"
          ],
          "properties": {
            "committed": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "dirty": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "growth": {
          "$ref": "#/$defs/growth"
        }
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suggestedMode",
        "reasons",
        "degradedReason",
        "impacted",
        "needsReview",
        "unmapped",
        "pagination"
      ],
      "properties": {
        "suggestedMode": {
          "type": "string",
          "enum": [
            "light",
            "deep"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "degradedReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "impacted": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "changedCommittedPaths",
              "dirtyPaths"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/path"
              },
              "changedCommittedPaths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "dirtyPaths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "needsReview": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unmapped": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "committed",
            "dirty"
          ],
          "properties": {
            "committed": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "dirty": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "pagination": {
          "$ref": "#/$defs/pagination"
        }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "updateAll",
        "updated",
        "baselineRevision"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "success"
        },
        "updateAll": {
          "type": "boolean"
        },
        "updated": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "baselineRevision": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "prune": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "writable",
        "growth",
        "startupPreloads",
        "duplicateCandidates",
        "mergeCandidates"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "dry_run"
        },
        "writable": {
          "type": "boolean",
          "const": false
        },
        "growth": {
          "$ref": "#/$defs/growth"
        },
        "startupPreloads": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "duplicateCandidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "paths",
              "score",
              "reasons"
            ],
            "properties": {
              "paths": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "score": {
                "type": "number"
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "mergeCandidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "topic",
              "paths",
              "totalEstimatedTokens",
              "reasons"
            ],
            "properties": {
              "topic": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "totalEstimatedTokens": {
                "type": "integer",
                "minimum": 0
              },
              "reasons": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "upgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "legacyPaths",
        "targetStructure",
        "requiresRecorderSemanticMigration",
        "notes"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "no_change",
            "dry_run"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "legacyPaths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "targetStructure": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requiresRecorderSemanticMigration": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "new": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created",
        "next"
      ],
      "properties": {
        "created": {
          "type": "string",
          "minLength": 1
        },
        "next": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "adopt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adopted",
        "alreadyRegistered"
      ],
      "properties": {
        "adopted": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "alreadyRegistered": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "mv": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moved",
        "rewrittenConfig",
        "rewrittenDocuments"
      ],
      "properties": {
        "moved": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "string",
              "minLength": 1
            },
            "to": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "rewrittenDocuments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rewrittenConfig": {
          "type": "boolean"
        }
      }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "continue"
      ],
      "properties": {
        "continue": {
          "type": "boolean",
          "const": true
        },
        "systemMessage": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "initState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "documents",
        "baselineRevision",
        "next"
      ],
      "properties": {
        "status": {
          "type": "string",
          "const": "success"
        },
        "documents": {
          "type": "integer",
          "minimum": 0
        },
        "baselineRevision": {
          "type": "string",
          "minLength": 1
        },
        "next": {
          "type": "string"
        }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "commits",
        "updated"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "success",
            "no_change"
          ]
        },
        "commits": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "updated": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "baselineAdvanced": {
          "type": "boolean"
        }
      }
    },
    "bind": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "repositoryId",
        "sourcePath",
        "knowledgeRoot"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "bound",
            "already-bound"
          ]
        },
        "repositoryId": {
          "type": "string",
          "pattern": "^llmdoc-[0-9a-f]{32}$"
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "knowledgeRoot": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "init": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositoryId",
        "sourcePath",
        "knowledgeRoot",
        "knowledgeCommit"
      ],
      "properties": {
        "repositoryId": {
          "type": "string",
          "pattern": "^llmdoc-[0-9a-f]{32}$"
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "knowledgeRoot": {
          "type": "string",
          "minLength": 1
        },
        "knowledgeCommit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "knowledgeError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "paths",
            "remediation"
          ],
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "remediation": {
              "type": "string"
            }
          }
        }
      }
    },
    "knowledgeKind": {
      "type": "string",
      "enum": [
        "architecture",
        "decision",
        "guide",
        "reference"
      ]
    },
    "knowledgeStatus": {
      "type": "string",
      "enum": [
        "unverified",
        "current",
        "needs_review"
      ]
    },
    "readMode": {
      "type": "string",
      "enum": [
        "bound",
        "explicit",
        "unbound"
      ]
    },
    "knowledgeDocumentSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "description",
        "topic",
        "status",
        "reasons",
        "sourcePaths",
        "requires",
        "supersededBy"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/knowledgeKind"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "topic": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/$defs/knowledgeStatus"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sourcePaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supersededBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "knowledgeSearchResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "description",
        "status",
        "reasons",
        "supersededBy",
        "supersedes",
        "score",
        "snippet"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/knowledgeKind"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "description": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/knowledgeStatus"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supersededBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "score": {
          "type": "number"
        },
        "snippet": {
          "type": "string"
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "mode",
        "repositoryId",
        "sourceRevision",
        "unbound",
        "query",
        "searchMode",
        "results",
        "pagination",
        "knowledgeRevision",
        "lastGlobalReviewRevision",
        "sourceBlockers",
        "historyAvailable",
        "issues"
      ],
      "properties": {
        "schema": {
          "const": "llmdoc.search/v1"
        },
        "mode": {
          "$ref": "#/$defs/readMode"
        },
        "repositoryId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "unbound": {
          "type": "boolean"
        },
        "query": {
          "type": "string"
        },
        "searchMode": {
          "type": "string",
          "enum": [
            "lexical",
            "cjk-bigram-fallback"
          ]
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeSearchResult"
          }
        },
        "pagination": {
          "$ref": "#/$defs/pagination"
        },
        "knowledgeRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastGlobalReviewRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceBlockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeSourceBlocker"
          }
        },
        "historyAvailable": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeIssue"
          }
        }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "mode",
        "repositoryId",
        "sourceRevision",
        "unbound",
        "documents",
        "pagination",
        "knowledgeRevision",
        "lastGlobalReviewRevision",
        "sourceBlockers",
        "historyAvailable",
        "issues"
      ],
      "properties": {
        "schema": {
          "const": "llmdoc.index/v1"
        },
        "mode": {
          "$ref": "#/$defs/readMode"
        },
        "repositoryId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "unbound": {
          "type": "boolean"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeDocumentSummary"
          }
        },
        "pagination": {
          "$ref": "#/$defs/pagination"
        },
        "knowledgeRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastGlobalReviewRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceBlockers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeSourceBlocker"
          }
        },
        "historyAvailable": {
          "type": "boolean"
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/knowledgeIssue"
          }
        }
      }
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "mode",
        "repositoryId",
        "sourceRevision",
        "unbound",
        "topics",
        "rootSingletons",
        "pagination",
        "knowledgeRevision",
        "lastGlobalReviewRevision",
        "sourceBlockers",
        "historyAvailable",
        "issues"
      ],
      "properties": {
        "schema": {
          "const": "llmdoc.tree/v1"
        },
        "mode": {
          "$ref": "#/$defs/readMode"
        },
        "repositoryId": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "unbound": {
          "type": "boolean"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "object",
