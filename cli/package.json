{
  "name": "@tokenroll/llmdoc",
  "version": "3.6.0",
  "description": "Dual-repository knowledge CLI for llmdoc",
  "homepage": "https://github.com/TokenRollAI/llmdoc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TokenRollAI/llmdoc.git"
  },
  "author": "DJJ & Danniel",
  "type": "module",
  "bin": {
    "llmdoc": "./dist/bin/llmdoc.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "schemas",
    "assets"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && node -e \"require('node:fs').chmodSync('dist/bin/llmdoc.js', 0o755)\"",
    "prepack": "npm run build",
    "lint": "eslint src tests",
    "test": "npm run build && npm run test:quick",
    "test:quick": "vitest run --config vitest.quick.config.ts && vitest run tests/knowledge-review-seal.test.ts -t \"seals changed docs and meta in a single commit and leaves the worktree clean\"",
    "test:integration": "npm run build && vitest run --reporter=verbose",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "commander": "^13.1.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.1",
    "marked": "^15.0.12",
    "minimatch": "^9.0.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.3.0",
    "eslint": "9.39.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.46.4",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
