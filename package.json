{
  "name": "@vegetablebird6/llmdoc-repository",
  "version": "3.6.1-ng",
  "private": true,
  "description": "Development workspace for the llmdoc dual-repository CLI and plugin surfaces",
  "scripts": {
    "build": "npm --prefix cli run build",
    "lint": "npm --prefix cli run lint",
    "test": "npm --prefix cli test",
    "test:integration": "npm --prefix cli run test:integration",
    "typecheck": "npm --prefix cli run typecheck",
    "validate:dogfood": "npm --prefix cli exec -- vitest run tests/knowledge-dogfood-e2e.test.ts",
    "check:prompts": "node scripts/check-prompt-budget.mjs"
  },
  "devDependencies": {
    "@vegetablebird6/llmdoc": "file:cli",
    "gray-matter": "^4.0.3"
  },
  "overrides": {
    "vite": "6.4.3"
  },
  "engines": {
    "node": ">=18"
  }
}
